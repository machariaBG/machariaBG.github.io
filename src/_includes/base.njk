<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {%- set pageTitle -%}
    {%- if page.url == "/" -%}{{ title | default(site.defaultTitle) }}{%- else -%}{{ title }} | {{ site.name }}{%- endif -%}
  {%- endset %}
  {%- set pageDesc = description | default(site.defaultDescription) -%}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:image" content="{{ site.url }}{{ ogImage | default(site.ogImage) }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDesc }}">
  <meta name="twitter:image" content="{{ site.url }}{{ ogImage | default(site.ogImage) }}">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self';">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <link rel="stylesheet" href="/css/style.css">
  {%- if page.url == "/" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}/",
    "email": "mailto:{{ site.email }}",
    "jobTitle": "IT Support & Technical Operations",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Nairobi",
      "addressCountry": "KE"
    },
    "sameAs": [
      "{{ site.github }}",
      "{{ site.linkedin }}"
    ],
    "alumniOf": {
      "@type": "CollegeOrUniversity",
      "name": "Kenyatta University"
    },
    "hasCredential": {
      "@type": "EducationalOccupationalCredential",
      "name": "CompTIA Security+ (SY0-701)",
      "credentialCategory": "certification"
    }
  }
  </script>
  {%- endif %}
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  
  <header class="site-header">
    <div class="container nav-wrapper">
      <a href="/" class="logo" aria-label="Home">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <!-- Systems motif -->
          <rect x="3" y="3" width="6" height="6" stroke-width="1.5" />
          <rect x="15" y="15" width="6" height="6" stroke-width="1.5" />
          <path d="M9 6h6v9" />
          <circle cx="15" cy="6" r="1.5" fill="var(--color-amber)" stroke="none"/>
        </svg>
        {{ site.shortName }}
      </a>
      <nav class="main-nav" aria-label="Main Navigation">
        {%- for item in site.nav %}
          {%- set isCurrent = (page.url == item.url) or (item.url != "/" and page.url and page.url.startsWith(item.url)) %}
          <a href="{{ item.url }}"{% if isCurrent %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {%- endfor %}
      </nav>
    </div>
  </header>

  <main id="main-content" tabindex="-1">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="social-links">
        <a href="{{ site.github }}" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="/cv/">CV</a>
      </div>
      <p>{{ site.name }}. Field Notes &copy; 2026. Built with Eleventy.</p>
    </div>
  </footer>

  <dialog id="gallery-dialog" class="gallery-dialog" aria-label="Image Gallery">
    <button type="button" class="lb-btn lb-close" aria-label="Close gallery">&times;</button>
    <div class="lb-wrapper">
      <button type="button" class="lb-btn lb-prev" aria-label="Previous image">&lsaquo;</button>
      <img class="lb-img" id="lb-current-img" alt="" eleventy:ignore>
      <button type="button" class="lb-btn lb-next" aria-label="Next image">&rsaquo;</button>
    </div>
    <div class="lb-info" aria-live="polite">
      <span class="lb-title" id="lb-title"></span>
      <span class="lb-counter" id="lb-counter"></span>
    </div>
    <div class="lb-thumbs" id="lb-thumbs"></div>
  </dialog>

  <script src="/assets/gallery.js" defer></script>
</body>
</html>

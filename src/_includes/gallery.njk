{% macro item(url, label, src, alt, title, medium) %}
<a href="{{ url }}" class="gallery-item" aria-label="{{ label }}">
  <img src="{{ src }}" alt="{{ alt }}" sizes="(max-width: 768px) 100vw, 480px">
  <div class="gallery-caption">
    <span class="gallery-title">{{ title }}</span>
    <span class="gallery-medium">{{ medium }}</span>
  </div>
</a>
{% endmacro %}

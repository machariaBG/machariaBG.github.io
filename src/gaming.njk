---
layout: base.njk
title: Gaming Journal
description: Ranked list of Bradon Gaathe Macharia's favourite video games and filterable in-game photography gallery.
templateEngineOverride: njk
---
{% macro gaming_item(url, label, src, alt, title, medium, game_id) %}
<a href="{{ url }}" class="gallery-item gallery-item--gaming" data-game="{{ game_id }}" aria-label="{{ label }}">
  <img src="{{ src }}" alt="{{ alt }}" sizes="(max-width: 600px) 100vw, 400px">
  <div class="gallery-caption">
    <span class="gallery-title">{{ title }}</span>
    <span class="gallery-medium">{{ medium }}</span>
  </div>
</a>
{% endmacro %}

{%- set sortedScreenshotGames = gamingScreenshots | sortScreenshotsByGames(games) -%}

<div class="container section animate-entrance">
  <div class="case-study-header">
    <span class="annotation">Gaming</span>
    <h1 class="display-font">My Favourite Games</h1>
    <p class="lead-narrow">
      A ranked list of the titles that left a lasting impression on me, along with some of my favourite screenshots captured along the way.
    </p>
    <div class="mt-md">
      <a href="#screenshot-gallery" class="btn btn-outline btn-sm">Browse Screenshots &darr;</a>
    </div>
  </div>

  <ol class="games-list">
    {% for game in games | sort(attribute='rank') %}
      <li class="game-card {% if game.rank <= 3 %}top-three{% endif %}">
        <div class="game-header">
          <h2 class="display-font game-title">
            <span class="game-rank">#{{ game.rank }}</span> {{ game.title }}
          </h2>
          {% if game.platform %}<span class="annotation">{{ game.platform }}</span>{% endif %}
        </div>

        {% if game.notes %}
          <p class="game-note">{{ game.notes }}</p>
        {% endif %}

        {% if game.review %}
          <p class="game-note">{{ game.review }}</p>
        {% endif %}

        {% if game.favourite_moment %}
          <p class="game-moment">
            <strong>Favourite Moment:</strong> {{ game.favourite_moment }}
          </p>
        {% endif %}
      </li>
    {% endfor %}
  </ol>

  <div id="screenshot-gallery" class="screenshots-section">
    <h2 class="display-font section-heading">Screenshot Gallery</h2>
    
    <div class="gallery-filters" role="group" aria-label="Screenshot Filters">
      <button type="button" class="btn filter-btn active" data-filter="all" aria-pressed="true">All Games</button>
      {% for game in sortedScreenshotGames %}
        {% if game.screenshots and game.screenshots.length > 0 %}
          <button type="button" class="btn btn-outline filter-btn" data-filter="{{ game.id }}" aria-pressed="false">{{ game.title }}</button>
        {% endif %}
      {% endfor %}
    </div>

    <div id="filter-announcer" aria-live="polite" class="sr-only">
      Showing all screenshots.
    </div>

    <div id="screenshot-grid" class="gallery-grid interests-gallery grid-layout-multi">
      {% for game in sortedScreenshotGames %}
        {% if game.screenshots %}
          {% for shot in game.screenshots %}
            {{ gaming_item(shot.path, "View screenshot from " + game.title, shot.path, shot.alt_text, shot.caption, game.title, game.id) }}
          {% endfor %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>
